<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="launch_surface">#F1F0EA</color>

    <style name="BaseLaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:statusBarColor">@color/launch_surface</item>
        <item name="android:navigationBarColor">@color/launch_surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="LaunchTheme" parent="@style/BaseLaunchTheme" />

    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/launch_surface</item>
    </style>
</resources>

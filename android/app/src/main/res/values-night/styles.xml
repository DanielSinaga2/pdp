<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="launch_surface">#161D19</color>

    <style name="BaseLaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/padisehat_launch_background</item>
        <item name="android:statusBarColor">@color/launch_surface</item>
        <item name="android:navigationBarColor">@color/launch_surface</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/launch_surface</item>
    </style>
</resources>
